      "tags": ["mock", "logic"],
      "solver_visible": {
        "problem": "三个人甲、乙、丙中只有一个人说真话。甲说：乙说真话。乙说：丙说真话。丙说：甲和乙都在说谎。谁说真话？"
      },
      "judge_visible": {
        "reference": "丙说真话。若甲真则乙真，矛盾；若乙真则丙真，矛盾；若丙真，则甲、乙均假，自洽。",
        "rubric": {
          "version": "1.0",
          "dimensions": [
            { "id": "correctness", "description": "结论是否为丙说真话", "max_score": 100 },
            { "id": "proof", "description": "是否排除甲、乙两种情形并验证丙自洽", "max_score": 100 }
          ],
          "fatal_error_policy": "结论选错人即 fatal_error=true，全部维度记 0 分。"
        },
        "pitfalls": ["只给结论没有排除过程", "把‘只有一人说真话’误读为‘至少一人’"],
